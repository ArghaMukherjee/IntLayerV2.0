    "/v1/admin/requests/{request_id}/replay": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Replay Request",
        "description": "Re-queues a FAILED request (any source app).",
        "operationId": "replay_request_v1_admin_requests__request_id__replay_post",
        "security": [
          {
            "APIKeyHeader": []
          }
