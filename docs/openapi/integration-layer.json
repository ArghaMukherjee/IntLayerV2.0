      "SubmitRequest": {
        "properties": {
          "workflow_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,62}$",
            "title": "Workflow Name",
            "examples": [
              "order_validation"
            ]
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload",
            "description": "Business JSON; validated against the workflow's input_schema"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
