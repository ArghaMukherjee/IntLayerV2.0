{
  "openapi": "3.1.0",
  "info": {
    "title": "MyCareHub",
    "description": "Member-facing care portal. Submits care requests to the Integration Layer (workflow care_request) and receives the results by signed callback.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/members": {
      "get": {
        "tags": [
          "members"
        ],
        "summary": "Members",
        "operationId": "members_api_members_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/care-requests": {
      "post": {
        "tags": [
          "care requests"
        ],
        "summary": "Create Care Request",
        "description": "Submits a care request through the Integration Layer. Returns its HTTP status and body.",
        "operationId": "create_care_request_api_care_requests_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CareRequestIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "care requests"
        ],
        "summary": "List Care Requests",
        "operationId": "list_care_requests_api_care_requests_get",
        "parameters": [
          {
            "name": "member_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^M-\\d{4}$",
              "title": "Member Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/care-requests/{request_id}": {
      "get": {
        "tags": [
          "care requests"
        ],
        "summary": "Care Request",
        "operationId": "care_request_api_care_requests__request_id__get",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/care-requests/{request_id}/cancel": {
      "post": {
        "tags": [
          "care requests"
        ],
        "summary": "Cancel",
        "operationId": "cancel_api_care_requests__request_id__cancel_post",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/hooks/il": {
      "post": {
        "tags": [
          "callbacks"
        ],
        "summary": "Receive Callback",
        "description": "Signed callback from the Integration Layer when a care request finishes.",
        "operationId": "receive_callback_hooks_il_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "callbacks"
        ],
        "summary": "Notifications",
        "operationId": "notifications_api_notifications_get",
        "parameters": [
          {
            "name": "member_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Member Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CareRequestIn": {
        "properties": {
          "member_id": {
            "type": "string",
            "title": "Member Id"
          },
          "request_type": {
            "type": "string",
            "enum": [
              "appointment",
              "prescription_refill",
              "referral",
              "lab_results"
            ],
            "title": "Request Type"
          },
          "urgency": {
            "type": "string",
            "enum": [
              "routine",
              "soon",
              "urgent"
            ],
            "title": "Urgency",
            "default": "routine"
          },
          "preferred_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Date"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "member_id",
          "request_type"
        ],
        "title": "CareRequestIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}