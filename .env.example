# Copy to .env and change every value before `docker compose up`.
# Use letters and digits only in passwords (they are embedded in connection URLs).
# Tip: generate values with   openssl rand -hex 16

# PostgreSQL superuser and the service login users
POSTGRES_PASSWORD=change_me_postgres
IL_API_DB_PASSWORD=change_me_il
CONSUMER_DB_PASSWORD=change_me_consumer
SCHEDULER_DB_PASSWORD=change_me_scheduler
BI_READER_DB_PASSWORD=change_me_bi
CONSOLE_DB_PASSWORD=change_me_console

# API keys the source applications send in X-API-Key, and the admin key for /v1/admin/*
WWMG_API_KEY=wwmg-dev-key
MYCAREHUB_API_KEY=mycarehub-dev-key
ADMIN_API_KEY=admin-dev-key

# Shared secret used to sign callbacks (X-IL-Signature); the source apps verify it
CALLBACK_SIGNING_SECRET=change_me_callback_secret

# Hosts allowed in callback_url (comma-separated; empty = any)
CALLBACK_ALLOWED_HOSTS=wwmg-source,mycarehub

# BigQuery. Defaults target the local emulator; see docker-compose.gcp.yml for real BigQuery.
BQ_PROJECT=intlayer-local
BQ_DATASET=integration
BQ_LOCATION=US
